# -------------------------------------------------------------------------
# 2. METRICS
# -------------------------------------------------------------------------

macro_f1 <- function(y_true, y_pred) {
  classes <- sort(unique(c(y_true, y_pred)))

  f1_values <- map_dbl(classes, function(cls) {
    tp <- sum(y_true == cls & y_pred == cls)
    fp <- sum(y_true != cls & y_pred == cls)
    fn <- sum(y_true == cls & y_pred != cls)

    precision <- ifelse(tp + fp == 0, 0, tp / (tp + fp))
    recall <- ifelse(tp + fn == 0, 0, tp / (tp + fn))

    if (precision + recall == 0) {
      0
    } else {
      2 * precision * recall / (precision + recall)
    }
  })

  mean(f1_values)
}

quadratic_weighted_kappa <- function(y_true, y_pred) {
  labels <- sort(unique(c(y_true, y_pred)))
  k <- length(labels)

  if (k < 2) {
    return(NA_real_)
  }

  true_idx <- match(y_true, labels)
  pred_idx <- match(y_pred, labels)

  observed <- table(
    factor(true_idx, levels = seq_len(k)),
    factor(pred_idx, levels = seq_len(k))
  )
  observed <- observed / sum(observed)

  true_hist <- rowSums(observed)
  pred_hist <- colSums(observed)
  expected <- outer(true_hist, pred_hist)

  weights <- outer(
    seq_len(k),
    seq_len(k),
    function(i, j) ((i - j)^2) / ((k - 1)^2)
  )

  observed_disagreement <- sum(weights * observed)
  expected_disagreement <- sum(weights * expected)

  if (expected_disagreement == 0) {
    return(NA_real_)
  }

  1 - observed_disagreement / expected_disagreement
}

metric_vector <- function(data) {
  tibble(
    n = nrow(data),
    macro_f1 = macro_f1(data$y_true, data$y_pred),
    qwk = quadratic_weighted_kappa(data$y_true, data$y_pred),
    accuracy = mean(data$y_true == data$y_pred),
    ordinal_mae = mean(abs(data$y_true - data$y_pred))
  )
}

# -------------------------------------------------------------------------
# 3. LOAD AND STANDARDIZE
# -------------------------------------------------------------------------

read_prediction_file <- function(path, dataset, method) {
  if (!file.exists(path)) {
    warning("Missing file: ", path)
    return(NULL)
  }

  x <- read_csv(path, show_col_types = FALSE)

  required <- c("participant_id", "y_true", "y_pred")
  missing_columns <- setdiff(required, names(x))

  if (length(missing_columns) > 0) {
    stop(
      "File ", path, " is missing columns: ",
      paste(missing_columns, collapse = ", ")
    )
  }

  if (!"fold" %in% names(x)) {
    x$fold <- 1L
  }

  if (!"budget" %in% names(x)) {
    x$budget <- "full"
  }

  x %>%
    mutate(
      dataset = dataset,
      method = method,
      participant_id = as.character(participant_id),
      fold = as.character(fold),
      budget = as.character(budget),
      y_true = as.integer(y_true),
      y_pred = as.integer(y_pred),
      correct = as.integer(y_true == y_pred),
      ordinal_abs_error = abs(y_true - y_pred)
    )
}

predictions <- pmap_dfr(
  prediction_files,
  read_prediction_file
)

if (nrow(predictions) == 0) {
  stop("No prediction files could be loaded.")
}

write_csv(predictions, file.path(output_dir, "predictions_combined.csv"))

# -------------------------------------------------------------------------
# 4. METRICS BY FOLD
# -------------------------------------------------------------------------

metrics_by_fold <- predictions %>%
  group_by(dataset, method, budget, fold) %>%
  group_modify(~ metric_vector(.x)) %>%
  ungroup()

write_csv(metrics_by_fold, file.path(output_dir, "metrics_by_fold.csv"))

metrics_summary <- metrics_by_fold %>%
  group_by(dataset, method, budget) %>%
  summarise(
    n_folds = n(),
    macro_f1_mean = mean(macro_f1, na.rm = TRUE),
    macro_f1_sd = sd(macro_f1, na.rm = TRUE),
    macro_f1_se = macro_f1_sd / sqrt(n_folds),
    macro_f1_ci_low = macro_f1_mean - qt(0.975, pmax(n_folds - 1, 1)) * macro_f1_se,
    macro_f1_ci_high = macro_f1_mean + qt(0.975, pmax(n_folds - 1, 1)) * macro_f1_se,
    qwk_mean = mean(qwk, na.rm = TRUE),
    qwk_sd = sd(qwk, na.rm = TRUE),
    qwk_se = qwk_sd / sqrt(n_folds),
    qwk_ci_low = qwk_mean - qt(0.975, pmax(n_folds - 1, 1)) * qwk_se,
    qwk_ci_high = qwk_mean + qt(0.975, pmax(n_folds - 1, 1)) * qwk_se,
    .groups = "drop"
  )

write_csv(metrics_summary, file.path(output_dir, "metrics_summary.csv"))

