# -------------------------------------------------------------------------
# 6. PAIRED PATIENT-LEVEL BOOTSTRAP
# -------------------------------------------------------------------------

paired_bootstrap_delta <- function(
  data,
  method_a,
  method_b,
  metric = c("macro_f1", "qwk"),
  repetitions = 2000,
  seed = 2026
) {
  metric <- match.arg(metric)

  wide <- data %>%
    filter(method %in% c(method_a, method_b)) %>%
    select(
      dataset,
      budget,
      fold,
      participant_id,
      method,
      y_true,
      y_pred
    ) %>%
    distinct() %>%
    pivot_wider(
      names_from = method,
      values_from = y_pred
    ) %>%
    drop_na(all_of(c(method_a, method_b)))

  if (nrow(wide) == 0) {
    return(tibble())
  }

  set.seed(seed)

  deltas <- replicate(repetitions, {
    sampled_rows <- sample.int(
      nrow(wide),
      size = nrow(wide),
      replace = TRUE
    )

    boot <- wide[sampled_rows, ]

    if (metric == "macro_f1") {
      value_a <- macro_f1(boot$y_true, boot[[method_a]])
      value_b <- macro_f1(boot$y_true, boot[[method_b]])
    } else {
      value_a <- quadratic_weighted_kappa(boot$y_true, boot[[method_a]])
      value_b <- quadratic_weighted_kappa(boot$y_true, boot[[method_b]])
    }

    value_b - value_a
  })

  tibble(
    reference = method_a,
    comparison = method_b,
    metric = metric,
    delta_mean = mean(deltas, na.rm = TRUE),
    ci_low = quantile(deltas, 0.025, na.rm = TRUE),
    ci_high = quantile(deltas, 0.975, na.rm = TRUE),
    p_two_sided = 2 * min(
      mean(deltas <= 0, na.rm = TRUE),
      mean(deltas >= 0, na.rm = TRUE)
    )
  )
}

comparison_methods <- setdiff(unique(predictions$method), reference_method)

bootstrap_results <- crossing(
  dataset = unique(predictions$dataset),
  budget = unique(predictions$budget),
  comparison = comparison_methods,
  metric = c("macro_f1", "qwk")
) %>%
  pmap_dfr(function(dataset, budget, comparison, metric) {
    subset_data <- predictions %>%
      filter(
        .data$dataset == dataset,
        .data$budget == budget
      )

    result <- paired_bootstrap_delta(
      subset_data,
      method_a = reference_method,
      method_b = comparison,
      metric = metric,
      repetitions = bootstrap_repetitions,
      seed = bootstrap_seed
    )

    if (nrow(result) == 0) {
      return(tibble())
    }

    result %>%
      mutate(
        dataset = dataset,
        budget = budget
      )
  })

write_csv(
  bootstrap_results,
  file.path(output_dir, "paired_bootstrap_vs_reference.csv")
)

# -------------------------------------------------------------------------
# 7. OPTIONAL MIXED-EFFECTS MODELS
# -------------------------------------------------------------------------

model_data <- predictions %>%
  mutate(
    method = factor(method),
    dataset = factor(dataset),
    budget = factor(budget),
    fold = factor(fold),
    participant_id = factor(participant_id)
  )

if (n_distinct(model_data$method) >= 2) {
  correctness_model <- glmer(
    correct ~ method * budget + dataset +
      (1 | participant_id) +
      (1 | fold),
    data = model_data,
    family = binomial,
    control = glmerControl(
      optimizer = "bobyqa",
      optCtrl = list(maxfun = 2e5)
    )
  )

  saveRDS(
    correctness_model,
    file.path(output_dir, "mixed_model_correctness.rds")
  )

  write_csv(
    tidy(
      correctness_model,
      effects = "fixed",
      conf.int = TRUE,
      exponentiate = TRUE
    ),
    file.path(output_dir, "mixed_model_correctness_fixed_effects.csv")
  )

  correctness_emmeans <- emmeans(
    correctness_model,
    pairwise ~ method | dataset + budget,
    type = "response",
    adjust = "tukey"
  )

  write_csv(
    as.data.frame(correctness_emmeans$contrasts),
    file.path(output_dir, "mixed_model_correctness_pairwise.csv")
  )

  ordinal_error_model <- lmer(
    ordinal_abs_error ~ method * budget + dataset +
      (1 | participant_id) +
      (1 | fold),
    data = model_data
  )

  saveRDS(
    ordinal_error_model,
    file.path(output_dir, "mixed_model_ordinal_error.rds")
  )

  write_csv(
    tidy(
      ordinal_error_model,
      effects = "fixed",
      conf.int = TRUE
    ),
    file.path(output_dir, "mixed_model_ordinal_error_fixed_effects.csv")
  )
}

message("Analysis complete. Results saved in: ", output_dir)
